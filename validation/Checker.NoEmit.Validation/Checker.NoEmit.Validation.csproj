<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <!-- Source-qualified test harness shares existing Program.Checks friend access. -->
    <AssemblyName>Program.Checks</AssemblyName><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TypeScript.Scanner/TypeScript.Scanner.csproj" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
    <Compile Include="../Program.Checks/*.cs" />
    <Compile Include="../Configuration.Checks/ConfigurationFileSystem.cs" />
    <Compile Include="../Configuration.Checks/Check.cs" />
  </ItemGroup>
</Project>
