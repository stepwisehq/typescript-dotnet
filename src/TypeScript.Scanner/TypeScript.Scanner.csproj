<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Bundled/Libs/*.d.ts" LogicalName="TypeScript.Bundled.Libs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Checker/Libraries/lib.es5.d.ts" LogicalName="TypeScript.Checking.Libraries.lib.es5.d.ts" />
    <EmbeddedResource Include="Checker/Libraries/lib.decorators.d.ts" LogicalName="TypeScript.Checking.Libraries.lib.decorators.d.ts" />
    <EmbeddedResource Include="Checker/Libraries/lib.decorators.legacy.d.ts" LogicalName="TypeScript.Checking.Libraries.lib.decorators.legacy.d.ts" />
    <EmbeddedResource Include="Checker/Libraries/manifest.json" LogicalName="TypeScript.Checking.Libraries.Manifest.json" />
  </ItemGroup>
</Project>
